  <circuit name="Branch_Control">
    <a name="appearance" val="custom"/>
    <a name="circuit" val="Branch_Control"/>
    <a name="simulationFrequency" val="1.0"/>
    <appear>
      <rect fill="none" height="200" stroke="#000000" stroke-width="2" width="220" x="50" y="50"/>
      <text dominant-baseline="central" font-family="SansSerif" font-size="15" font-weight="bold" text-anchor="middle" x="160" y="115">Branch_Control</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="10" text-anchor="start" x="55" y="70">BR_EQ</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="10" text-anchor="start" x="55" y="110">BR_NE</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="10" text-anchor="start" x="55" y="150">EQUAL</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="10" text-anchor="start" x="55" y="190">PC_WRITE</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="10" text-anchor="end" x="265" y="110">TAKE_BRANCH</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="10" text-anchor="end" x="265" y="150">PC_EN</text>
      <circ-anchor facing="east" x="50" y="50"/>
      <circ-port dir="in" pin="180,180" x="50" y="70"/>
      <circ-port dir="in" pin="180,300" x="50" y="110"/>
      <circ-port dir="in" pin="180,420" x="50" y="150"/>
      <circ-port dir="in" pin="180,580" x="50" y="190"/>
      <circ-port dir="out" pin="760,300" x="270" y="110"/>
      <circ-port dir="out" pin="760,560" x="270" y="150"/>
    </appear>
    <comp lib="0" loc="(180,180)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="BR_EQ"/>
      <a name="labelfont" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" loc="(180,300)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="BR_NE"/>
      <a name="labelfont" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" loc="(180,420)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="EQUAL"/>
      <a name="labelfont" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" loc="(180,580)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="PC_WRITE"/>
    </comp>
    <comp lib="0" loc="(760,300)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="label" val="TAKE_BRANCH"/>
      <a name="labelfont" val="SansSerif plain 12"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="0" loc="(760,560)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="label" val="PC_EN"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="1" loc="(340,420)" name="NOT Gate"/>
    <comp lib="1" loc="(500,220)" name="AND Gate"/>
    <comp lib="1" loc="(500,380)" name="AND Gate"/>
    <comp lib="1" loc="(650,300)" name="OR Gate"/>
