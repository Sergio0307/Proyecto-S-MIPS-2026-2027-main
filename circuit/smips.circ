    <comp lib="7" loc="(410,1330)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="escritura $gp: D = rd XOR 0x1800"/>
    </comp>
    <comp lib="7" loc="(410,1630)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="escritura $sp: D = rd XOR 0x3FFC"/>
    </comp>
    <comp lib="7" loc="(640,100)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="$zero: constante 0 (sin registro): leer x0 da 0 y escribirlo no tiene efecto"/>
    </comp>
    <comp lib="7" loc="(860,1270)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="$gp (x28) y $sp (x29) reinician a 0x1800 y 0x3FFC ([R6]): el registro fisico guarda (valor XOR inicial) y su clear asincrono (reset) lo pone a 0, asi que al leer con XOR sale el valor inicial."/>
    </comp>
    <comp lib="7" loc="(910,1330)" name="Text">
