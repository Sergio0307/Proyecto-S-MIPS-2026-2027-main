    <comp lib="7" loc="(520,65)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="TAKE_BRANCH = (BR_EQ &amp; EQUAL) | (BR_NE &amp; !EQUAL)   |   PC_EN = PC_WRITE | TAKE_BRANCH (escribir el PC en este ciclo)"/>
    </comp>
